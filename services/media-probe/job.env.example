# Copy to job.env (not in git) and fill in; scripts/deploy-media-probe.sh reads it.

GCP_PROJECT=your-cloud-project-id
REGION=europe-north1
JOB=media-probe
SERVICE_ACCOUNT=media-probe           # the part before @<project>.iam.gserviceaccount.com
SPREADSHEET_ID=                       # the Asset Manager spreadsheet (from its URL)
