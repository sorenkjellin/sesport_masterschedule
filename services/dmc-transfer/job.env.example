# Copy to job.env (not in git) and fill in; scripts/deploy-dmc-transfer.sh reads it.
# The FTP password is not here: it is in Secret Manager as the secret named in FTP_PASSWORD_SECRET.

GCP_PROJECT=your-cloud-project-id
REGION=europe-north1
JOB=dmc-transfer
SERVICE_ACCOUNT=dmc-transfer          # the part before @<project>.iam.gserviceaccount.com
FTP_PASSWORD_SECRET=dmc-ftp-password

FTP_HOST=ftp-no1.dmcproduction.se
FTP_PORT=21
FTP_USER=
FTP_DIR=                              # folder at DMC; empty for the login folder
FTP_TEMP_SUFFIX=.part                 # "none" to upload under the final name directly

SPREADSHEET_ID=17kWFQnWMV-1AS1gw9DxL2JQgkRFD28gAOwCESiXAtFs
PARALLELISM=2                         # clips sent at the same time
